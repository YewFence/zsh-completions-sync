_qmd_collection() {
  local context state state_descr line curcontext="$curcontext"
  typeset -A opt_args

  local -a subcommands
  subcommands=(
    'list:list all collections'
    'add:add a collection'
    'remove:remove a collection'
    'rm:remove a collection'
    'rename:rename a collection'
    'mv:rename a collection'
    'show:show collection details'
    'info:show collection details'
    'update-cmd:set pre-update command'
    'set-update:set pre-update command'
    'include:include collection in default queries'
    'exclude:exclude collection from default queries'
    'help:show collection help'
  )

  _arguments -C \
    $_qmd_global_options \
    '1:command:->command' \
    '*::arg:->arg'

  case $state in
    command)
      _describe -t commands 'collection command' subcommands
      ;;
    arg)
      case $words[1] in
        list)
          ;;
        add)
          _arguments \
            '--name=[collection name]:name:' \
            '--mask=[glob pattern]:glob pattern:' \
            '1:directory:_files -/'
          ;;
        remove|rm)
          _arguments \
            '1:collection:_qmd_collections' \
            '*:command word:'
          ;;
        rename|mv)
          _arguments \
            '1:old collection:_qmd_collections' \
            '2:new collection name:'
          ;;
        show|info)
          _arguments \
            '1:collection:_qmd_collections' \
            '*:command word:'
          ;;
        update-cmd|set-update)
          _arguments \
            '1:collection:_qmd_collections' \
            '*:command word:'
          ;;
        include)
          _arguments \
            '1:collection:_qmd_collections' \
            '*:command word:'
          ;;
        exclude)
          _arguments \
            '1:collection:_qmd_collections' \
            '*:command word:'
          ;;
        help)
          ;;
      esac
      ;;
  esac
}

