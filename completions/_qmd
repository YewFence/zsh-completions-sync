_qmd() {
  local context state state_descr line curcontext="$curcontext"
  typeset -A opt_args

  local -a commands
  commands=(
    'init:initialize a project-local index'
    'collection:manage collections'
    'context:manage search context'
    'ls:list collections or files'
    'get:get a document by path or docid'
    'multi-get:get multiple documents by glob or list'
    'status:show index status'
    'doctor:diagnose the install'
    'update:re-index collections'
    'embed:generate vector embeddings'
    'pull:pull local models'
    'search:full-text keyword search'
    'vsearch:vector similarity search'
    'vector-search:vector similarity search'
    'query:hybrid search with expansion and reranking'
    'deep-search:hybrid search with expansion and reranking'
    'bench:run search quality benchmarks'
    'mcp:start MCP server'
    'skills:list QMD skills'
    'skill:show or install the QMD skill'
    'cleanup:clean cache and orphaned data'
  )

  _arguments -C \
    $_qmd_global_options \
    '1:command:->command' \
    '*::arg:->arg'

  case $state in
    command)
      _describe -t commands 'qmd command' commands
      ;;
    arg)
      curcontext="${curcontext%:*:*}:qmd-$words[1]:"
      case $words[1] in
        init)
          ;;
        collection)
          _qmd_collection
          ;;
        context)
          _qmd_context
          ;;
        ls)
          _arguments \
            '1:collection or qmd path:_alternative '\''collections:collection:_qmd_collections'\'' '\''qmd-paths:qmd path:_guard "qmd://*" "qmd path"'\'''
          ;;
        get)
          _arguments \
            $_qmd_get_options \
            '1:file or docid:_files'
          ;;
        multi-get)
          _arguments \
            $_qmd_multi_get_options \
            '1:glob, list, or docid:_files'
          ;;
        status)
          ;;
        doctor)
          ;;
        update)
          _arguments \
            '--pull[run collection pre-update commands before indexing]'
          ;;
        embed)
          _arguments \
            '(-f --force)'{-f,--force}'[re-embed everything]' \
            '(-c --collection)'{-c,--collection}'[embed collection]:collection:_qmd_collections' \
            '--chunk-strategy=[chunk strategy]:strategy:_qmd_chunk_strategies' \
            '--max-docs-per-batch=[maximum docs per batch]:number:' \
            '--max-batch-mb=[maximum batch size in MB]:megabytes:' \
            '--timeout=[maximum duration]:duration:'
          ;;
        pull)
          _arguments \
            '--refresh[refresh cached model metadata]'
          ;;
        search)
          _arguments \
            $_qmd_search_options \
            '*:query:'
          ;;
        vsearch)
          _arguments \
            $_qmd_search_options \
            '*:query:'
          ;;
        vector-search)
          _arguments \
            $_qmd_search_options \
            '*:query:'
          ;;
        query)
          _arguments \
            $_qmd_search_options \
            '*:query:'
          ;;
        deep-search)
          _arguments \
            $_qmd_search_options \
            '*:query:'
          ;;
        bench)
          _arguments \
            '(-c --collection)'{-c,--collection}'[benchmark collection]:collection:_qmd_collections' \
            '--json[JSON output]' \
            '1:fixture JSON:_files -g "*.json(-.)"'
          ;;
        mcp)
          _qmd_mcp
          ;;
        skills)
          _arguments \
            '--json[JSON output]' \
            '--full[include full skill content]' \
            '--all[include all skills]' \
            '*:skill name:'
          ;;
        skill)
          _qmd_skill
          ;;
        cleanup)
          ;;
      esac
      ;;
  esac
}

_qmd "$@"
