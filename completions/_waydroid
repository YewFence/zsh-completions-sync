_waydroid() {
  local context state state_descr line curcontext="$curcontext"
  typeset -A opt_args

  local -a commands
  commands=(
    'status:quick check for the waydroid'
    'log:follow the waydroid logfile'
    'init:set up waydroid specific configs and install images'
    'upgrade:upgrade images'
    'session:session controller'
    'container:container controller'
    'app:applications controller'
    'prop:android properties controller'
    'show-full-ui:show android full screen in window'
    'first-launch:start waydroid, prompting to initialize first if necessary'
    'shell:run remote shell command'
    'logcat:show android logcat'
    'adb:manage adb connection'
    'bugreport:create a bugreport archive interactively'
  )

  _arguments -C \
    $_waydroid_global_options \
    '1:command:->command' \
    '*::arg:->arg'

  case $state in
    command)
      _describe -t commands 'waydroid command' commands
      ;;
    arg)
      curcontext="${curcontext%:*:*}:waydroid-$line[1]:"
      case $line[1] in
        status)
          ;;
        log)
          _arguments \
            '(-n --lines)'{-n,--lines=}'[count of initial output lines]:lines:' \
            '(-c --clear)'{-c,--clear}'[clear the log]'
          ;;
        init)
          _arguments \
            '(-i --images_path)'{-i,--images_path=}'[custom path to waydroid images]:images path:_files -/' \
            '(-f --force)'{-f,--force}'[re-initialize configs and images]' \
            '(-c --system_channel)'{-c,--system_channel=}'[custom system channel]:system channel:' \
            '--vendor_channel=[custom vendor channel]:vendor channel:' \
            '(-r --rom_type)'{-r,--rom_type=}'[rom type]:rom type:_waydroid_rom_types' \
            '(-s --system_type)'{-s,--system_type=}'[system type]:system type:_waydroid_system_types' \
            '--client[run as user mode]'
          ;;
        upgrade)
          _arguments \
            '(-o --offline)'{-o,--offline}'[just for updating configs]'
          ;;
        session)
          _waydroid_session
          ;;
        container)
          _waydroid_container
          ;;
        app)
          _waydroid_app
          ;;
        prop)
          _waydroid_prop
          ;;
        show-full-ui)
          ;;
        first-launch)
          ;;
        shell)
          _arguments \
            '(-u --uid)'{-u,--uid=}'[UID to run as]:uid:' \
            '(-g --gid)'{-g,--gid=}'[GID to run as]:gid:' \
            '(-s --context)'{-s,--context=}'[security context]:context:' \
            '(-L --nolsm)'{-L,--nolsm}'[do not perform security domain transition]' \
            '(-C --allcaps)'{-C,--allcaps}'[do not drop capabilities]' \
            '(-G --nocgroup)'{-G,--nocgroup}'[do not switch to the container cgroup]' \
            '*:command:'
          ;;
        logcat)
          _arguments \
            '*:args:'
          ;;
        adb)
          _waydroid_adb
          ;;
        bugreport)
          ;;
      esac
      ;;
  esac
}

_waydroid "$@"
